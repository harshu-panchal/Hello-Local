# Adloggs delivery integration (Phase 6). Placeholders only — never commit real values.
# Everything defaults to OFF. Production use is blocked in code for this phase.
ADLOGGS_ENVIRONMENT=            # "development" (https://dev.adloggs.com) or "production" (blocked in Phase 6)
ADLOGGS_API_KEY=                # provided by Adloggs; server-side only, sent as the x-api-key header
ADLOGGS_INTEGRATION_ENABLED=false
ADLOGGS_BOOKING_WORKER_ENABLED=false
ADLOGGS_STATUS_POLLING_ENABLED=false
ADLOGGS_CANCELLATION_WORKER_ENABLED=false
ADLOGGS_WEBHOOK_ENABLED=false   # webhooks are rejected anyway until Adloggs confirms its authentication contract
ADLOGGS_COD_ENABLED=false       # ignored: Adloggs COD is blocked in code until remittance rules are verified
ADLOGGS_PICKUP_WINDOW_MINUTES=30  # approved business window (default 30 if unset); real bookings stay blocked in code until Adloggs confirms pickup_date_time semantics
ADLOGGS_REQUEST_TIMEOUT_MS=10000
ADLOGGS_STATUS_POLL_INTERVAL_SECONDS=120
ADLOGGS_WEBHOOK_TOKEN=   # secret for the webhook URL /api/v1/webhooks/adloggs/<token>; generate with: openssl rand -hex 32 (never commit the real value)
